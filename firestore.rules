rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validador estrito de dados da tarefa privada
    function isValidTarefa(data) {
      return data.keys().hasAll(['titulo', 'prioridade', 'status', 'userId', 'criadoEm'])
        && data.keys().hasOnly(['titulo', 'descricao', 'prioridade', 'categoria', 'dataLimite', 'status', 'subtarefas', 'userId', 'criadoEm'])
        && data.titulo is string && data.titulo.size() >= 1 && data.titulo.size() <= 120
        && (!('descricao' in data) || (data.descricao is string && data.descricao.size() <= 500))
        && data.prioridade is string && (data.prioridade == 'baixa' || data.prioridade == 'media' || data.prioridade == 'alta')
        && (!('categoria' in data) || (data.categoria is string && data.categoria.size() <= 30))
        && (!('dataLimite' in data) || (data.dataLimite is string && data.dataLimite.size() <= 10))
        && data.status is string && (data.status == 'pendente' || data.status == 'concluida')
        && (!('subtarefas' in data) || (data.subtarefas is list && data.subtarefas.size() <= 20))
        && data.userId is string && data.userId == request.auth.uid
        && data.criadoEm is number;
    }

    match /tarefas/{tarefaId} {
      // 1. Leitura: somente o proprietário da tarefa pode ler seus próprios dados
      allow read: if isOwner(resource.data.userId);

      // 2. Criação: usuário autenticado deve definir a si mesmo como proprietário (userId == request.auth.uid)
      allow create: if isOwner(request.resource.data.userId) && isValidTarefa(request.resource.data);

      // 3. Atualização: somente o proprietário original pode atualizar, proibindo transferência de propriedade
      allow update: if isOwner(resource.data.userId)
                   && isOwner(request.resource.data.userId)
                   && isValidTarefa(request.resource.data);

      // 4. Exclusão: somente o proprietário pode excluir seu documento
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
